HTTP_ADDRESS=:8080
DATABASE_URL=postgres://rivo:rivo_dev@localhost:5432/rivo?sslmode=disable
VIDEO_STORAGE_PATH=../../data/videos
WEB_ORIGIN=http://localhost:3000

# Largest accepted upload, in bytes. Defaults to 1 GiB.
MAX_UPLOAD_BYTES=1073741824

# Per-client token bucket on authenticated write routes. Burst is how many requests
# a client may make back to back; the refill is how many tokens it regains a minute.
UPLOAD_RATE_LIMIT_BURST=5
UPLOAD_RATE_LIMIT_PER_MINUTE=10
